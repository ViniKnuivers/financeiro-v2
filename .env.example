# Supabase (Project Settings → API). Sem estas duas, o site roda só no navegador, sem login.
# A "publishable key" é pública por definição (vai junto com o site); quem protege os dados
# são as regras do banco (RLS em supabase/migrations). Nunca coloque aqui a "secret key".
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
